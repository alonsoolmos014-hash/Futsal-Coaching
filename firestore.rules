rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // CAMBIA ESTE CORREO por tu cuenta Google principal (en minúsculas).
    function adminEmail() { return 'alonsoolmos014@gmail.com'; }
    function signedIn() {
      return request.auth != null
        && request.auth.token.email is string
        && request.auth.token.email_verified == true;
    }
    function currentEmail() { return request.auth.token.email.lower(); }
    function isAdmin() {
      return signedIn() && currentEmail() == adminEmail();
    }
    function myProfileExists() {
      return signedIn() && exists(/databases/$(database)/documents/users/$(request.auth.uid));
    }
    function active() {
      return myProfileExists()
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.status == 'active';
    }
    function validEmailList(d) {
      return d.accessEmails is list && d.accessEmails.size() <= 100;
    }

    // Directorio mínimo de cuentas. Administrador puede ver cuentas, pero NO su entrenamiento privado.
    match /users/{userId} {
      allow get: if signedIn() && (request.auth.uid == userId || isAdmin());
      allow list: if isAdmin() && active();
      allow create: if signedIn() && request.auth.uid == userId
        && request.resource.data.keys().hasOnly(['uid','email','displayName','photoURL','role','status','createdAt'])
        && request.resource.data.keys().hasAll(['uid','email','displayName','role','status','createdAt'])
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.email == currentEmail()
        && request.resource.data.status == 'active'
        && request.resource.data.role == (isAdmin() ? 'admin' : 'user')
        && request.resource.data.displayName is string
        && request.resource.data.displayName.size() <= 100;
      allow update: if signedIn() && (
        // El usuario puede cambiar solo su nombre visible y foto; NUNCA rol, UID, correo o estado.
        (request.auth.uid == userId && active()
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['displayName','photoURL','profileBio','profileCity','profilePosition'])
          && request.resource.data.displayName is string
          && request.resource.data.displayName.size() <= 100
          && (!('profileBio' in request.resource.data) || (request.resource.data.profileBio is string && request.resource.data.profileBio.size() <= 240))
          && (!('profileCity' in request.resource.data) || (request.resource.data.profileCity is string && request.resource.data.profileCity.size() <= 60))
          && (!('profilePosition' in request.resource.data) || (request.resource.data.profilePosition is string && request.resource.data.profilePosition.size() <= 32))
          && (!('photoURL' in request.resource.data) || (request.resource.data.photoURL is string && request.resource.data.photoURL.size() <= 2048)))
        ||
        // El superadministrador puede suspender/reactivar cuentas normales.
        (isAdmin() && active() && userId != request.auth.uid
          && resource.data.role == 'user'
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status'])
          && request.resource.data.status in ['active','suspended'])
      );
      allow delete: if false;
    }

    // Datos independientes para cada propietario. Invitados: únicamente lectura con enlace y email autorizado.
    // Soporte: acceso temporal de lectura SOLO si el propietario activa supportAccess.
    match /workspaces/{ownerUid}/state/{stateId} {
      allow get: if stateId == 'main' && active() && (
        request.auth.uid == ownerUid
        || (resource.data.accessEmails is list && currentEmail() in resource.data.accessEmails)
        || (isAdmin() && resource.data.supportAccess == true)
      );
      allow list: if false;
      allow create: if stateId == 'main' && active() && request.auth.uid == ownerUid
        && request.resource.data.ownerUid == ownerUid
        && validEmailList(request.resource.data)
        && request.resource.data.supportAccess is bool;
      allow update: if stateId == 'main' && active() && request.auth.uid == ownerUid
        && resource.data.ownerUid == ownerUid
        && request.resource.data.ownerUid == ownerUid
        && validEmailList(request.resource.data)
        && request.resource.data.supportAccess is bool;
      allow delete: if false;
    }

    // Solicitudes de soporte: solo el remitente y el superadministrador.
    match /supportTickets/{ticketId} {
      allow create: if active()
        && request.resource.data.keys().hasOnly(['userUid','email','subject','body','status','adminReply','createdAt','updatedAt'])
        && request.resource.data.keys().hasAll(['userUid','email','subject','body','status','adminReply','createdAt','updatedAt'])
        && request.resource.data.userUid == request.auth.uid
        && request.resource.data.email == currentEmail()
        && request.resource.data.status == 'open'
        && request.resource.data.adminReply == ''
        && request.resource.data.subject is string
        && request.resource.data.subject.size() >= 3
        && request.resource.data.subject.size() <= 120
        && request.resource.data.body is string
        && request.resource.data.body.size() >= 10
        && request.resource.data.body.size() <= 3000;
      allow get: if active() && (isAdmin() || resource.data.userUid == request.auth.uid);
      // Las consultas del usuario deben filtrar por userUid == request.auth.uid.
      allow list: if active() && (isAdmin() || resource.data.userUid == request.auth.uid);
      allow update: if isAdmin() && active()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status','adminReply','updatedAt'])
        && request.resource.data.status in ['open','in_progress','resolved']
        && request.resource.data.adminReply is string
        && request.resource.data.adminReply.size() <= 3000;
      allow delete: if false;
    }

    // Compatibilidad SOLO LECTURA para que el propietario original pueda importar su club antiguo.
    match /club/main { allow get: if isAdmin() && active(); allow list, create, update, delete: if false; }

    // ===== Olmos Coaching 5.x: clubes independientes y datos por colección =====
    // El superadministrador global NO tiene acceso automático a un club ajeno.
    function memberPath(clubId, uid) {
      return /databases/$(database)/documents/clubs/$(clubId)/members/$(uid);
    }
    function memberExists(clubId) {
      return active() && exists(memberPath(clubId, request.auth.uid));
    }
    function memberData(clubId) {
      return get(memberPath(clubId, request.auth.uid)).data;
    }
    function clubMember(clubId) {
      return memberExists(clubId) && memberData(clubId).status == 'active';
    }
    function clubRole(clubId) {
      return memberData(clubId).role;
    }
    function clubOwner(clubId) {
      return clubMember(clubId) && clubRole(clubId) == 'owner';
    }
    function clubStaff(clubId) {
      return clubMember(clubId)
        && clubRole(clubId) in ['owner', 'head_coach', 'assistant', 'analyst'];
    }
    function clubEditor(clubId) {
      return clubMember(clubId)
        && clubRole(clubId) in ['owner', 'head_coach', 'assistant'];
    }
    function memberPlayerId(clubId) {
      return memberData(clubId).playerId;
    }
    function safeWrite() {
      return request.resource.data.keys().hasAll(['createdAt','updatedAt']);
    }
    // Directorio optativo: solo se muestran clubes, NUNCA datos individuales de jugadores.
    match /clubDirectory/{clubId} {
      allow get: if active() && (resource.data.published == true || clubOwner(clubId));
      allow list: if active() && resource.data.published == true;
      allow create: if clubOwner(clubId)
        && request.resource.data.keys().hasOnly(['clubId','name','city','description','category','published','updatedAt'])
        && request.resource.data.clubId == clubId
        && request.resource.data.name is string && request.resource.data.name.size() >= 3 && request.resource.data.name.size() <= 120
        && request.resource.data.city is string && request.resource.data.city.size() <= 60
        && request.resource.data.description is string && request.resource.data.description.size() <= 240
        && request.resource.data.category is string && request.resource.data.category.size() <= 50
        && request.resource.data.published is bool;
      allow update: if clubOwner(clubId)
        && request.resource.data.clubId == resource.data.clubId
        && request.resource.data.keys().hasOnly(['clubId','name','city','description','category','published','updatedAt'])
        && request.resource.data.name is string && request.resource.data.name.size() >= 3 && request.resource.data.name.size() <= 120
        && request.resource.data.city is string && request.resource.data.city.size() <= 60
        && request.resource.data.description is string && request.resource.data.description.size() <= 240
        && request.resource.data.category is string && request.resource.data.category.size() <= 50
        && request.resource.data.published is bool;
      allow delete: if clubOwner(clubId);
    }

    match /clubs/{clubId} {
      allow get: if clubMember(clubId);
      allow list: if false;
      allow create: if active()
        && request.resource.data.ownerUid == request.auth.uid
        && request.resource.data.name is string
        && request.resource.data.name.size() >= 3
        && request.resource.data.name.size() <= 120;
      allow update: if clubOwner(clubId)
        && request.resource.data.ownerUid == resource.data.ownerUid
        && request.resource.data.name is string
        && request.resource.data.name.size() <= 120;
      allow delete: if false;

      match /members/{memberUid} {
        allow get: if clubStaff(clubId) || (active() && memberUid == request.auth.uid);
        allow list: if clubStaff(clubId);
        allow create: if active() && request.auth.uid == memberUid
          && request.resource.data.uid == memberUid
          && request.resource.data.email == currentEmail()
          && request.resource.data.status == 'active'
          && (
            // Primer miembro propietario: debe crearse junto al club.
            (request.resource.data.role == 'owner'
              && getAfter(/databases/$(database)/documents/clubs/$(clubId)).data.ownerUid == memberUid)
            ||
            // Un invitado solo puede aceptar SU correo y el rol exacto concedido.
            (request.resource.data.role in ['head_coach','assistant','analyst','player']
              && request.resource.data.inviteId is string
              && exists(/databases/$(database)/documents/clubs/$(clubId)/invites/$(request.resource.data.inviteId))
              && get(/databases/$(database)/documents/clubs/$(clubId)/invites/$(request.resource.data.inviteId)).data.email == currentEmail()
              && get(/databases/$(database)/documents/clubs/$(clubId)/invites/$(request.resource.data.inviteId)).data.status == 'pending'
              && get(/databases/$(database)/documents/clubs/$(clubId)/invites/$(request.resource.data.inviteId)).data.role == request.resource.data.role
              && get(/databases/$(database)/documents/clubs/$(clubId)/invites/$(request.resource.data.inviteId)).data.playerId == request.resource.data.playerId
              && get(/databases/$(database)/documents/clubs/$(clubId)/invites/$(request.resource.data.inviteId)).data.teamId == request.resource.data.teamId)
          );
        allow update: if clubOwner(clubId)
          && memberUid != request.auth.uid
          && resource.data.role != 'owner'
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status','teamId','playerId'])
          && request.resource.data.status in ['active','suspended'];
        allow delete: if false;
      }
      // Solicitud individual: usuario pide entrar, propietario aprueba creando una invitación privada.
      match /joinRequests/{applicantUid} {
        allow get: if active() && (request.auth.uid == applicantUid || clubOwner(clubId));
        allow list: if clubOwner(clubId);
        allow create: if active() && request.auth.uid == applicantUid
          && !clubMember(clubId)
          && request.resource.data.keys().hasOnly(['uid','email','clubId','message','status','createdAt'])
          && request.resource.data.uid == applicantUid
          && request.resource.data.clubId == clubId
          && request.resource.data.email == currentEmail()
          && request.resource.data.status == 'pending'
          && request.resource.data.message is string && request.resource.data.message.size() <= 240
          && exists(/databases/$(database)/documents/clubDirectory/$(clubId))
          && get(/databases/$(database)/documents/clubDirectory/$(clubId)).data.published == true;
        allow update: if clubOwner(clubId)
          && resource.data.status == 'pending'
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status','inviteCode','reviewedAt'])
          && (
            request.resource.data.status == 'rejected'
            || (request.resource.data.status == 'approved'
              && request.resource.data.inviteCode is string
              && getAfter(/databases/$(database)/documents/clubs/$(clubId)/invites/$(request.resource.data.inviteCode)).data.email == resource.data.email
              && getAfter(/databases/$(database)/documents/clubs/$(clubId)/invites/$(request.resource.data.inviteCode)).data.role == 'player'
              && getAfter(/databases/$(database)/documents/clubs/$(clubId)/invites/$(request.resource.data.inviteCode)).data.status == 'pending')
          );
        allow delete: if false;
      }
      match /invites/{inviteId} {
        allow get: if clubOwner(clubId) || (active() && resource.data.email == currentEmail());
        allow list: if clubOwner(clubId);
        allow create: if clubOwner(clubId)
          && request.resource.data.createdBy == request.auth.uid
          && request.resource.data.email is string
          && request.resource.data.email.size() <= 254
          && request.resource.data.role in ['head_coach','assistant','analyst','player']
          && request.resource.data.status == 'pending';
        allow update: if clubOwner(clubId)
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status'])
          && request.resource.data.status in ['pending','revoked'];
        allow delete: if false;
      }
      // Información de equipo compartible con integrantes autorizados.
      match /teams/{id} {
        allow read: if clubMember(clubId);
        allow create, update, delete: if clubEditor(clubId);
      }
      match /seasons/{id} {
        allow read: if clubMember(clubId);
        allow create, update, delete: if clubEditor(clubId);
      }
      match /matches/{id} {
        allow read: if clubMember(clubId);
        allow create, update, delete: if clubStaff(clubId);
      }
      match /microcycles/{id} {
        allow read: if clubMember(clubId);
        allow create, update, delete: if clubEditor(clubId);
      }
      match /trainingSessions/{id} {
        allow read: if clubMember(clubId);
        allow create, update, delete: if clubEditor(clubId);
      }
      match /principles/{id} {
        allow read: if clubMember(clubId);
        allow create, update, delete: if clubEditor(clubId);
      }
      match /tactics/{id} {
        allow read: if clubMember(clubId);
        allow create, update, delete: if clubStaff(clubId);
      }
      match /developmentPlans/{id} {
        allow get, list: if clubStaff(clubId)
          || (clubMember(clubId) && memberPlayerId(clubId) == resource.data.playerId);
        allow create, update, delete: if clubEditor(clubId);
      }
      // Datos privados de plantilla: un jugador obtiene su ficha, no la lista entera.
      match /players/{playerId} {
        allow get: if clubStaff(clubId) || (clubMember(clubId) && memberPlayerId(clubId) == playerId);
        allow list: if clubStaff(clubId);
        allow create, update, delete: if clubEditor(clubId);
      }
      // Eventos y scouting: datos internos del cuerpo técnico.
      match /events/{id} {
        allow read: if clubStaff(clubId);
        allow create, update, delete: if clubStaff(clubId);
      }
      match /scouting/{id} {
        allow read: if clubStaff(clubId);
        allow create, update, delete: if clubStaff(clubId);
      }
      // Un jugador puede consultar exclusivamente sus propias estadísticas.
      // Sus consultas deben incluir where('playerId','==',miPlayerId).
      match /stats/{id} {
        allow get, list: if clubStaff(clubId)
          || (clubMember(clubId) && memberPlayerId(clubId) == resource.data.playerId);
        allow create, update, delete: if clubStaff(clubId);
      }
      // Un jugador solo crea carga/RPE a nombre de su propia ficha y UID.
      match /loads/{id} {
        allow get, list: if clubStaff(clubId)
          || (clubMember(clubId) && resource.data.uid == request.auth.uid);
        allow create: if clubStaff(clubId) || (
          clubMember(clubId)
          && memberPlayerId(clubId) is string
          && memberPlayerId(clubId).size() > 0
          && request.resource.data.uid == request.auth.uid
          && request.resource.data.playerId == memberPlayerId(clubId)
          && request.resource.data.rpe is number
          && request.resource.data.rpe >= 0
          && request.resource.data.rpe <= 10
          && request.resource.data.duration is number
          && request.resource.data.duration >= 0
          && request.resource.data.duration <= 300
        );
        allow update, delete: if clubStaff(clubId);
      }
      // Respuestas de convocatoria por sesión. Los jugadores solo acceden a las suyas.
      match /attendance/{attendanceId} {
        allow get: if clubStaff(clubId) || (clubMember(clubId) && resource.data.uid == request.auth.uid);
        allow list: if clubStaff(clubId) || (clubMember(clubId) && resource.data.uid == request.auth.uid);
        allow create: if clubMember(clubId)
          && request.resource.data.keys().hasOnly(['uid','sessionId','teamId','status','updatedAt'])
          && request.resource.data.uid == request.auth.uid
          && request.resource.data.status in ['confirmed','declined']
          && request.resource.data.sessionId is string && request.resource.data.sessionId.size() > 0
          && attendanceId == (request.resource.data.sessionId + '_' + request.auth.uid)
          && exists(/databases/$(database)/documents/clubs/$(clubId)/trainingSessions/$(request.resource.data.sessionId))
          && request.resource.data.teamId == get(/databases/$(database)/documents/clubs/$(clubId)/trainingSessions/$(request.resource.data.sessionId)).data.teamId;
        allow update: if clubMember(clubId)
          && resource.data.uid == request.auth.uid
          && request.resource.data.uid == resource.data.uid
          && request.resource.data.sessionId == resource.data.sessionId
          && request.resource.data.teamId == resource.data.teamId
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status','updatedAt'])
          && request.resource.data.status in ['confirmed','declined'];
        allow delete: if false;
      }
      match /{anyOther=**} { allow read, write: if false; }
    }
    // Índice PRIVADO para que cada usuario vea qué clubes integran su cuenta.
    match /users/{userId}/clubLinks/{clubId} {
      allow get, list: if active() && request.auth.uid == userId;
      allow create: if active()
        && request.auth.uid == userId
        && request.resource.data.uid == userId
        && request.resource.data.clubId == clubId
        && getAfter(/databases/$(database)/documents/clubs/$(clubId)/members/$(userId)).data.status == 'active';
      allow update, delete: if false;
    }

    match /{document=**} { allow read, write: if false; }
  }
}
